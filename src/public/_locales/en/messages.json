  "welTagline": {
    "message": "Turn the expireddomains.net lists you browse into one collection you can filter, mark and export."
  },
  "welWhatTitle": {
    "message": "What is this for"
  },
  "welWhatSite": {
    "message": "ExpiredDomains.net is a free service that lists domains being released: deleted and expiring domains, domains pending deletion, and domains on auctions such as GoDaddy or Sedo. Every list is a paged table with metrics: backlinks, Web Archive age, which other zones are taken, and more."
  },
  "welWhatExt": {
    "message": "Picking domains there means paging through many pages. This extension saves the tables of the pages you open into one list in your browser — no duplicates, with filters, statuses, tags and notes, and export to CSV, TXT or the clipboard. It never opens pages or sends requests by itself."
  },
  "welStepAccountTitle": {
    "message": "Sign in to ExpiredDomains.net"
  },
  "welStepAccountText": {
    "message": "Most domain lists are shown only after you sign in — a free account is enough. Already registered? Open the site and sign in."
  },
  "linkRegister": {
    "message": "Sign up free"
  },
  "linkSiteOpen": {
    "message": "Open ExpiredDomains.net"
  },
  "welStepListTitle": {
    "message": "Open a domain list"
  },
  "welStepListText": {
    "message": "For example, Deleted .com Domains or an auction list. A small Expired Domains panel appears at the top right of the page with the number of domains on it."
  },
  "welStepSaveTitle": {
    "message": "Save the page"
  },
  "welStepSaveText": {
    "message": "Press “Save page” in that panel. Or turn on “Auto-capture on page load”: then every list page you open is saved by itself. Moving to the next page is up to you."
  },
  "welStepPanelTitle": {
    "message": "Review the list in the side panel"
  },
  "welStepPanelText": {
    "message": "Click the extension icon in the browser toolbar. The side panel stays open beside the site and updates as you save pages."
  },
  "welPanelTitle": {
    "message": "In the side panel"
  },
  "welPanelText": {
    "message": "Everything you saved, in one list:"
  },
  "welFeatureFilters": {
    "message": "Filters: text or /regex/, list, available or registered, data age, drop and deletion dates, running auctions, BL/DP, archive age, zones, name length."
  },
  "welFeaturePresets": {
    "message": "Presets: “Working — drops”, “Working — auctions” and up to 20 of your own."
  },
  "welFeatureMarks": {
    "message": "Statuses, tags and notes — for one domain or for all selected at once."
  },
  "welFeatureExport": {
    "message": "Export of the filtered list: CSV for Excel, TXT, or copy to the clipboard."
  },
  "welFeatureBackup": {
    "message": "Backup and restore of everything as a JSON file."
  },
  "welOpenPanel": {
    "message": "Open the side panel"
  },
  "welPinHint": {
    "message": "Tip: pin the Expired Domains icon to the toolbar (puzzle icon → pin) so the panel is one click away."
  },
  "welOpenPanelManual": {
    "message": "Click the Expired Domains icon in the browser toolbar to open the panel."
  },
  "welPrivacyTitle": {
    "message": "Everything stays with you"
  },
  "welPrivacyText": {
    "message": "The extension reads only the domain table and the list address of ExpiredDomains.net pages you open — not your account name, e-mail or balance. Data is kept only in this browser. No network requests, no analytics."
  },
  "welUnofficial": {
    "message": "Unofficial. Not affiliated with ExpiredDomains.net."
  },
  "emptyTitle": {
    "message": "Your list is empty"
  },
  "emptyText": {
    "message": "Expired Domains collects domain lists from ExpiredDomains.net — a free service with deleted, expiring and auction domains. Only pages you open yourself are saved."
  },
  "emptyStepAccount": {
    "message": "Sign in to ExpiredDomains.net — most lists are shown only after sign-in; a free account is enough."
  },
  "emptyStepList": {
    "message": "Open any domain list there."
  },
  "emptyStepSave": {
    "message": "Press “Save page” in the small panel at the top right, or turn on auto-capture."
  },
